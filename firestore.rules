rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function existing() {
      return resource.data;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt', 'updatedAt']) 
             && data.email is string && data.email.size() <= 200
             && (!('name' in data) || (data.name is string && data.name.size() <= 100))
             && data.createdAt is number
             && data.updatedAt is number;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId
                    && isValidUser(incoming());
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      
      // Allow any subcollections for the current user for now
      match /{document=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Orders
    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'plan', 'amount', 'status', 'createdAt', 'updatedAt'])
             && data.userId is string && data.userId.size() <= 128
             && data.plan is string && data.plan.size() <= 50
             && data.amount is number
             && data.status is string && data.status.size() <= 50
             && data.createdAt is number
             && data.updatedAt is number;
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn();
      // Orders are created/updated securely matching the userId
      allow create: if isSignedIn() && isValidId(orderId)
                    && isValidOrder(incoming())
                    && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(orderId) && (resource == null || resource.data.userId == request.auth.uid)
                    && isValidOrder(incoming())
                    && incoming().userId == existing().userId
                    && incoming().createdAt == existing().createdAt
                    && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    // Cases
    function isValidCase(data) {
      return data.keys().hasAll(['userId', 'country', 'visaType', 'status', 'createdAt', 'updatedAt'])
             && data.userId is string && data.userId.size() <= 128
             && data.country is string && data.country.size() <= 100
             && data.visaType is string && data.visaType.size() <= 100
             && data.status is string && data.status.size() <= 50
             && (!('refusalReasonsJson' in data) || (data.refusalReasonsJson is string && data.refusalReasonsJson.size() <= 10000))
             && (!('questionnaireResponsesJson' in data) || (data.questionnaireResponsesJson is string && data.questionnaireResponsesJson.size() <= 50000))
             && (!('generatedResultJson' in data) || (data.generatedResultJson is string && data.generatedResultJson.size() <= 500000))
             && data.createdAt is number
             && data.updatedAt is number;
    }

    match /cases/{caseId} {
      allow get: if isSignedIn() && isValidId(caseId) && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(caseId)
                    && isValidCase(incoming())
                    && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(caseId) && (resource == null || resource.data.userId == request.auth.uid)
                    && isValidCase(incoming())
                    && incoming().userId == existing().userId
                    && incoming().createdAt == existing().createdAt
                    && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'refusalReasonsJson', 'questionnaireResponsesJson', 'generatedResultJson', 'country', 'visaType', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(caseId) && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Documents
    function isValidDocument(data) {
      return data.keys().hasAll(['userId', 'fileName', 'storagePath', 'type', 'createdAt'])
             && data.userId is string && data.userId.size() <= 128
             && (!('caseId' in data) || (data.caseId is string && data.caseId.size() <= 128))
             && data.fileName is string && data.fileName.size() <= 500
             && data.storagePath is string && data.storagePath.size() <= 1000
             && data.type is string && data.type.size() <= 50
             && data.createdAt is number;
    }

    match /documents/{documentId} {
      allow get: if isSignedIn() && isValidId(documentId) && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(documentId)
                    && isValidDocument(incoming())
                    && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(documentId) && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Saved Drafts
    function isValidDraft(data) {
      return data.keys().hasAll(['userId', 'draftDataJson', 'updatedAt'])
             && data.userId is string && data.userId.size() <= 128
             && data.draftDataJson is string && data.draftDataJson.size() <= 500000
             && data.updatedAt is number;
    }
    
    match /saved_drafts/{draftId} {
      allow get: if isSignedIn() && isValidId(draftId) && draftId == request.auth.uid;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(draftId)
                    && isValidDraft(incoming())
                    && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(draftId) && draftId == request.auth.uid
                    && isValidDraft(incoming())
                    && incoming().userId == existing().userId
                    && incoming().diff(existing()).affectedKeys().hasOnly(['draftDataJson', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(draftId) && draftId == request.auth.uid;
    }
  }
}

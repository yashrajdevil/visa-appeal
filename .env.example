# Firebase Client SDK (Vite frontend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin SDK (Express server)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Gemini API
GEMINI_API_KEY=

# Creem Payments
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_STARTER_PRICE_ID=
CREEM_STANDARD_PRICE_ID=
CREEM_PREMIUM_PRICE_ID=

# Admin Auth (server-side only, never exposed to client)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-strong-password-here
# Optional: additional admin users (comma-separated, email:password format)
# ADMIN_EMAILS=editor@example.com:editorpass,author@example.com:authorpass

# Server
APP_URL=http://localhost:5173
PORT=3001
